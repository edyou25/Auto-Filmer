<?xml version="1.0"?>
<launch>
  <!-- Parameters for testing -->
  <param name="cam_cx" value="320.0" />
  <param name="cam_cy" value="240.0" />
  <param name="min_dis" value="2.0" />
  <param name="max_dis" value="5.0" />
  <param name="tracking_dt" value="0.1" />
  
  <!-- Run the test -->
  <test test-name="test_shot_generator" pkg="local_sensing_node" type="test_shot_generator" />
</launch>
